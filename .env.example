# --- App URL ----------------------------------------------------------
# Public origin the app is served from. Used to build redirects
# (post-login landing, logout, etc.) so they don't fall back to the
# internal request URL when running behind a reverse proxy.
# Local dev: http://localhost:3000
# Prod:      https://your-domain.tld
APP_URL=http://localhost:3000

# --- Database ---------------------------------------------------------
# Any Postgres connection string (local, Neon, Supabase, Render, etc.)
DATABASE_URL=postgres://user:password@localhost:5432/tinymd

# --- Hack Club OAuth --------------------------------------------------
# Register an app at https://auth.hackclub.com/ and paste its credentials.
HACKCLUB_CLIENT_ID=
HACKCLUB_CLIENT_SECRET=

# Where Hack Club Auth should send users after they sign in.
# Must match exactly the redirect URI you registered.
HACKCLUB_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Optional — only set if Hack Club Auth changes its endpoints.
# HACKCLUB_AUTHORIZE_URL=https://auth.hackclub.com/oauth/authorize
# HACKCLUB_TOKEN_URL=https://auth.hackclub.com/oauth/token
# HACKCLUB_USERINFO_URL=https://auth.hackclub.com/api/v1/me

# --- Session secret (any long random string) --------------------------
SESSION_SECRET=change-me-please-32-bytes-of-random
