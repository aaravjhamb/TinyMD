# --- App URL ----------------------------------------------------------
# Public origin the app is served from. Single source of truth for
# redirects (post-login landing, logout) and the OAuth callback URL
# sent to Hack Club Auth. Must match a redirect URI you've registered
# at https://auth.hackclub.com/.
# Local dev: http://localhost:3000
# Prod:      https://your-domain.tld
APP_URL=http://localhost:3000

# --- Database ---------------------------------------------------------
# Any Postgres connection string (local, Neon, Supabase, Render, etc.)
DATABASE_URL=postgres://user:password@localhost:5432/tinymd

# --- Hack Club OAuth --------------------------------------------------
# Register an app at https://auth.hackclub.com/ and paste its credentials.
# Register ${APP_URL}/api/auth/callback as the redirect URI in the
# Hack Club Auth dashboard for each environment you deploy to.
HACKCLUB_CLIENT_ID=
HACKCLUB_CLIENT_SECRET=

# Optional — only set if Hack Club Auth changes its endpoints.
# HACKCLUB_AUTHORIZE_URL=https://auth.hackclub.com/oauth/authorize
# HACKCLUB_TOKEN_URL=https://auth.hackclub.com/oauth/token
# HACKCLUB_USERINFO_URL=https://auth.hackclub.com/api/v1/me

# --- Session secret (any long random string) --------------------------
SESSION_SECRET=change-me-please-32-bytes-of-random

# --- CDN --------------------------------------------------------------
# Base URL of the cdn instance used for image uploads. Defaults to
# https://cdn.aaravj.tech if unset. Point it at your own self-hosted
# cdn instance if you run one.
# CDN_BASE_URL=https://cdn.aaravj.tech
